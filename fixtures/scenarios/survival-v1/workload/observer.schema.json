{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Session-Bench survival-v1 independent observer",
  "type": "object",
  "properties": {
    "schema_version": {"const": "1.0-survival-observer"},
    "protocol_version": {"const": "1.0-survival"},
    "scenario_id": {"const": "survival-v1-repair"},
    "run_id": {"type": "string", "minLength": 1},
    "independent": {"const": true},
    "method": {"type": "string", "minLength": 1},
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "sequence": {"type": "integer", "minimum": 1},
          "boundary": {"enum": ["accepted", "displayed", "helper_invoked", "helper_emitted", "harness_received", "file_observed"]},
          "population_role": {"enum": ["primary_scored", "supporting", "unscored"]},
          "kind": {"enum": ["user_turn", "assistant_response", "action", "result", "helper", "file_change", "usage_total", "portable"]},
          "session_id": {"type": "string", "minLength": 1},
          "source": {"enum": ["submitted_input", "visible_stream", "harness_trace", "helper_ledger", "filesystem_snapshot", "usage_trace", "constructed_spec"]},
          "fields": {"type": "object"},
          "metric_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}
        },
        "required": ["id", "sequence", "boundary", "population_role", "kind", "session_id", "source", "fields", "metric_ids"],
        "additionalProperties": false
      }
    },
    "relations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["action_result", "turn_response", "supersedes", "final_after", "helper_for"]},
          "from_id": {"type": "string", "minLength": 1},
          "to_id": {"type": "string", "minLength": 1},
          "sequence": {"type": "integer", "minimum": 1}
        },
        "required": ["id", "kind", "from_id", "to_id", "sequence"],
        "additionalProperties": false
      }
    }
  },
  "required": ["schema_version", "protocol_version", "scenario_id", "run_id", "independent", "method", "events", "relations"],
  "additionalProperties": false
}
