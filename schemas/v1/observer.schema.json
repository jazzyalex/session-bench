{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Session-Bench offline prototype observer",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0-prototype"
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "boundary": {
            "enum": [
              "accepted",
              "helper_invoked",
              "helper_emitted",
              "harness_received",
              "displayed",
              "file_observed",
              "constructed"
            ]
          },
          "event_id": {
            "type": "string",
            "minLength": 1
          },
          "session_id": {
            "type": "string",
            "minLength": 1
          },
          "fields": {
            "type": "object"
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "sequence": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "id",
          "boundary",
          "event_id",
          "session_id",
          "fields",
          "source",
          "sequence"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "events"
  ],
  "additionalProperties": false
}
