{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Session-Bench offline prototype artifact",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "enum": [
        "native",
        "observer",
        "expected",
        "provenance",
        "workload"
      ]
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "id",
    "role",
    "path",
    "sha256",
    "size_bytes",
    "depends_on"
  ],
  "additionalProperties": false
}
