{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jazzyalex/session-bench/blob/main/schemas/v1/atlas.schema.json",
  "title": "Session-Bench public format atlas",
  "description": "A source-grounded inventory of coding-agent session surfaces. Documentation-only entries do not establish native writer behavior.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "atlas_id",
    "release_status",
    "edition_status",
    "purpose",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0-atlas"
    },
    "atlas_id": {
      "type": "string",
      "minLength": 1
    },
    "release_status": {
      "const": "draft_unreleased"
    },
    "edition_status": {
      "const": "documentation_only"
    },
    "purpose": {
      "const": "public format and surface inventory; not a conformance result"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "nullable_string": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "nullable_uri": {
      "anyOf": [
        {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://.+"
        },
        {
          "type": "null"
        }
      ]
    },
    "source_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "url",
        "title",
        "locator",
        "source_kind",
        "inspected_at"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/source_id"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://.+"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "source_kind": {
          "enum": [
            "official_documentation",
            "public_repository",
            "public_protocol",
            "other_public_source"
          ]
        },
        "inspected_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "subject",
        "state",
        "evidence_kind",
        "statement",
        "source_ids"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "subject": {
          "enum": [
            "surface_documentation",
            "artifact_documentation",
            "representability",
            "writer_behavior",
            "decoder_correctness",
            "reproduction"
          ]
        },
        "state": {
          "enum": [
            "documented",
            "unknown",
            "not_tested",
            "pass",
            "fail",
            "unresolved"
          ]
        },
        "evidence_kind": {
          "enum": [
            "public_documentation",
            "public_repository",
            "public_protocol",
            "native_bundle",
            "constructed_fixture",
            "independent_observation",
            "attestation",
            "none"
          ]
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "source_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_id"
          }
        },
        "unknowns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "root": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "description",
        "documented_path",
        "source_ids"
      ],
      "properties": {
        "role": {
          "enum": [
            "primary",
            "companion",
            "side_session",
            "subagent",
            "export",
            "diagnostic"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "documented_path": {
          "$ref": "#/$defs/nullable_string"
        },
        "source_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_id"
          }
        }
      }
    },
    "artifact_family": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity_state",
        "family_id",
        "physical_encoding",
        "tables_or_record_families",
        "roots",
        "session_id_fields",
        "join_keys",
        "surface_marker",
        "retention",
        "acquisition",
        "unknowns"
      ],
      "properties": {
        "identity_state": {
          "enum": [
            "unknown",
            "documented",
            "measured"
          ]
        },
        "family_id": {
          "$ref": "#/$defs/nullable_string"
        },
        "physical_encoding": {
          "$ref": "#/$defs/nullable_string"
        },
        "tables_or_record_families": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "roots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/root"
          }
        },
        "session_id_fields": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "join_keys": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "surface_marker": {
          "enum": [
            "documented",
            "unknown",
            "measured"
          ]
        },
        "retention": {
          "enum": [
            "documented",
            "unknown",
            "measured"
          ]
        },
        "acquisition": {
          "enum": [
            "public_documentation_only",
            "native_local_capture",
            "explicit_export",
            "unknown",
            "not_inspected"
          ]
        },
        "unknowns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_id",
        "status",
        "identity",
        "artifact_family",
        "claims",
        "sources",
        "maintenance",
        "correction",
        "measurement"
      ],
      "properties": {
        "entry_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "status": {
          "const": "documented_candidate"
        },
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "harness",
            "product",
            "application_version",
            "surface",
            "launch_mode",
            "os",
            "model_provider",
            "configuration",
            "identity_basis"
          ],
          "properties": {
            "harness": {
              "type": "string",
              "minLength": 1
            },
            "product": {
              "type": "string",
              "minLength": 1
            },
            "application_version": {
              "$ref": "#/$defs/nullable_string"
            },
            "surface": {
              "enum": [
                "cli",
                "desktop",
                "ide"
              ]
            },
            "launch_mode": {
              "type": "string",
              "minLength": 1
            },
            "os": {
              "type": "string",
              "minLength": 1
            },
            "model_provider": {
              "type": "string",
              "minLength": 1
            },
            "configuration": {
              "type": "string",
              "minLength": 1
            },
            "identity_basis": {
              "enum": [
                "public_documentation",
                "native_inspection",
                "independent_reproduction"
              ]
            }
          }
        },
        "artifact_family": {
          "$ref": "#/$defs/artifact_family"
        },
        "claims": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/claim"
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "maintenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maintenance_owner",
            "source_inspected_at",
            "live_tested_at",
            "next_inspection_due",
            "inspection_method"
          ],
          "properties": {
            "maintenance_owner": {
              "type": "string",
              "minLength": 1
            },
            "source_inspected_at": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "live_tested_at": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "next_inspection_due": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "inspection_method": {
              "enum": [
                "public_source_review",
                "native_inspection",
                "independent_reproduction"
              ]
            }
          }
        },
        "correction": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "issue_url",
            "supersedes_entry_id"
          ],
          "properties": {
            "status": {
              "enum": [
                "none",
                "open",
                "substantiated",
                "rejected",
                "unresolved"
              ]
            },
            "issue_url": {
              "$ref": "#/$defs/nullable_uri"
            },
            "supersedes_entry_id": {
              "$ref": "#/$defs/nullable_string"
            }
          }
        },
        "measurement": {
          "type": "null"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
