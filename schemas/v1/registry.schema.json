{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Session-Bench offline prototype registry",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0-prototype"
    },
    "surfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "subject": {
            "type": "object",
            "properties": {
              "harness": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "surface": {
                "enum": [
                  "cli",
                  "desktop",
                  "ide"
                ]
              },
              "mode": {
                "type": "string",
                "minLength": 1
              },
              "os": {
                "type": "string",
                "minLength": 1
              },
              "model": {
                "type": "string",
                "minLength": 1
              },
              "configuration": {
                "enum": [
                  "default",
                  "enhanced"
                ]
              },
              "artifact_family": {
                "type": "string",
                "minLength": 1
              },
              "schema_version": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "harness",
              "version",
              "surface",
              "mode",
              "os",
              "model",
              "configuration",
              "artifact_family",
              "schema_version"
            ],
            "additionalProperties": false
          },
          "status": {
            "enum": [
              "constructed_only",
              "candidate",
              "measured"
            ]
          },
          "maintenance_owner": {
            "type": "string",
            "minLength": 1
          },
          "source_inspected_at": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "live_tested_at": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "next_inspection_due": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "subject",
          "status",
          "maintenance_owner",
          "source_inspected_at",
          "live_tested_at",
          "next_inspection_due"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "surfaces"
  ],
  "additionalProperties": false
}
