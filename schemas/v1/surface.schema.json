{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Session-Bench offline prototype surface",
  "type": "object",
  "properties": {
    "harness": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "surface": {
      "enum": [
        "cli",
        "desktop",
        "ide"
      ]
    },
    "mode": {
      "type": "string",
      "minLength": 1
    },
    "os": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "configuration": {
      "enum": [
        "default",
        "enhanced"
      ]
    },
    "artifact_family": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "harness",
    "version",
    "surface",
    "mode",
    "os",
    "model",
    "configuration",
    "artifact_family",
    "schema_version"
  ],
  "additionalProperties": false
}
