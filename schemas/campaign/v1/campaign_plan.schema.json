{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Session-Bench offline campaign preparation plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "plan_id", "edition_id", "phase", "state",
    "execution_authority", "live_runs_completed", "targets", "scenarios",
    "profiles", "schedule", "budget", "retry_policy", "provenance",
    "forbidden_operations"
  ],
  "properties": {
    "schema_version": {"const": "1.0-campaign-plan"},
    "plan_id": {"$ref": "#/$defs/id"},
    "edition_id": {"$ref": "#/$defs/id"},
    "phase": {"enum": ["feasibility", "calibration", "first_edition", "recovery", "expansion"]},
    "state": {"enum": ["proposed", "ready_for_authorization"]},
    "execution_authority": {"const": "none_preparation_only"},
    "live_runs_completed": {"const": 0},
    "targets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/target"}},
    "scenarios": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/scenario"}},
    "profiles": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/profile"}},
    "schedule": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/schedule"}},
    "budget": {"$ref": "#/$defs/budget"},
    "retry_policy": {"$ref": "#/$defs/retry_policy"},
    "provenance": {"$ref": "#/$defs/provenance"},
    "forbidden_operations": {
      "type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "text": {"type": "string", "minLength": 1},
    "nullable_text": {"anyOf": [{"$ref": "#/$defs/text"}, {"type": "null"}]},
    "nullable_number": {"anyOf": [{"type": "number", "minimum": 0}, {"type": "null"}]},
    "nullable_sha256": {
      "anyOf": [
        {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        {"type": "null"}
      ]
    },
    "string_array": {"type": "array", "items": {"$ref": "#/$defs/text"}},
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["target_id", "subject", "artifact", "access", "isolation", "provenance"],
      "properties": {
        "target_id": {"$ref": "#/$defs/id"},
        "subject": {"$ref": "#/$defs/subject"},
        "artifact": {"$ref": "#/$defs/artifact"},
        "access": {"$ref": "#/$defs/access"},
        "isolation": {"$ref": "#/$defs/isolation"},
        "provenance": {"$ref": "#/$defs/target_provenance"}
      }
    },
    "subject": {
      "type": "object", "additionalProperties": false,
      "required": ["harness", "product", "application_version", "build_id", "surface", "launch_mode", "os", "model"],
      "properties": {
        "harness": {"$ref": "#/$defs/id"},
        "product": {"$ref": "#/$defs/text"},
        "application_version": {"$ref": "#/$defs/nullable_text"},
        "build_id": {"$ref": "#/$defs/nullable_text"},
        "surface": {"enum": ["cli", "desktop", "ide"]},
        "launch_mode": {"enum": ["interactive_local", "one_shot_local", "desktop_local", "ide_local"]},
        "os": {
          "type": "object", "additionalProperties": false,
          "required": ["family", "version", "architecture"],
          "properties": {
            "family": {"$ref": "#/$defs/text"},
            "version": {"$ref": "#/$defs/nullable_text"},
            "architecture": {"$ref": "#/$defs/nullable_text"}
          }
        },
        "model": {
          "type": "object", "additionalProperties": false,
          "required": ["provider", "id", "configuration_id", "settings_digest"],
          "properties": {
            "provider": {"$ref": "#/$defs/nullable_text"},
            "id": {"$ref": "#/$defs/nullable_text"},
            "configuration_id": {"$ref": "#/$defs/nullable_text"},
            "settings_digest": {
              "anyOf": [
                {"type": "string", "pattern": "^[a-f0-9]{64}$"},
                {"type": "null"}
              ]
            }
          }
        }
      }
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["track", "family_id", "identity_state", "primary_roots", "companion_policy", "session_join_keys", "export"],
      "properties": {
        "track": {"enum": ["native_local", "explicit_export"]},
        "family_id": {"$ref": "#/$defs/nullable_text"},
        "identity_state": {"enum": ["candidate", "documented", "verified"]},
        "primary_roots": {"$ref": "#/$defs/string_array"},
        "companion_policy": {"const": "capture_all_declared_companions"},
        "session_join_keys": {"$ref": "#/$defs/string_array"},
        "export": {
          "anyOf": [
            {"type": "null"},
            {
              "type": "object", "additionalProperties": false,
              "required": ["format", "version", "acquisition"],
              "properties": {
                "format": {"$ref": "#/$defs/text"},
                "version": {"$ref": "#/$defs/text"},
                "acquisition": {"$ref": "#/$defs/text"}
              }
            }
          ]
        }
      }
    },
    "access": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "account_profile", "launch_evidence_required", "private_store_access", "credential_policy", "operator_owner"],
      "properties": {
        "status": {"enum": ["unconfirmed", "confirmed", "blocked"]},
        "account_profile": {"$ref": "#/$defs/nullable_text"},
        "launch_evidence_required": {"const": true},
        "private_store_access": {"const": "forbidden"},
        "credential_policy": {"const": "do_not_copy_or_inspect"},
        "operator_owner": {"$ref": "#/$defs/text"}
      }
    },
    "isolation": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "authorized_roots", "root_discovery", "network", "undeclared_writes", "personal_history", "synthetic_project_id", "recovery_boundary"],
      "properties": {
        "status": {"enum": ["unconfirmed", "confirmed", "blocked"]},
        "authorized_roots": {"$ref": "#/$defs/string_array"},
        "root_discovery": {"const": "stat_only_before_after"},
        "network": {"enum": ["denied", "required_documented"]},
        "undeclared_writes": {"const": "denied"},
        "personal_history": {"const": "forbidden"},
        "synthetic_project_id": {"$ref": "#/$defs/nullable_text"},
        "recovery_boundary": {"enum": ["not_in_scope", "declared"]}
      }
    },
    "target_provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["source_ids", "fixture_id", "observer_id", "decoder_id", "identity_evidence_sha256", "access_evidence_sha256", "isolation_evidence_sha256", "artifact_evidence_sha256"],
      "properties": {
        "source_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}},
        "fixture_id": {"$ref": "#/$defs/text"},
        "observer_id": {"$ref": "#/$defs/text"},
        "decoder_id": {"$ref": "#/$defs/text"},
        "identity_evidence_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "access_evidence_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "isolation_evidence_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "artifact_evidence_sha256": {"$ref": "#/$defs/nullable_sha256"}
      }
    },
    "scenario": {
      "type": "object", "additionalProperties": false,
      "required": ["scenario_id", "scenario_class", "assertion_set", "mandatory", "native_sessions_per_run"],
      "properties": {
        "scenario_id": {"$ref": "#/$defs/id"},
        "scenario_class": {"enum": ["core", "advanced"]},
        "assertion_set": {"$ref": "#/$defs/text"},
        "mandatory": {"type": "boolean"},
        "native_sessions_per_run": {"type": "integer", "minimum": 1}
      }
    },
    "profile": {
      "type": "object", "additionalProperties": false,
      "required": ["profile_id", "profile_class", "scenario_ids", "applies_to_target_ids", "mandatory", "minimum_repetitions"],
      "properties": {
        "profile_id": {"$ref": "#/$defs/id"},
        "profile_class": {"enum": ["baseline", "advanced"]},
        "scenario_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}},
        "applies_to_target_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}},
        "mandatory": {"type": "boolean"},
        "minimum_repetitions": {"type": "integer", "minimum": 1}
      }
    },
    "schedule": {
      "type": "object", "additionalProperties": false,
      "required": ["schedule_id", "target_id", "profile_id", "repetitions"],
      "properties": {
        "schedule_id": {"$ref": "#/$defs/id"},
        "target_id": {"$ref": "#/$defs/id"},
        "profile_id": {"$ref": "#/$defs/id"},
        "repetitions": {"type": "integer", "minimum": 1}
      }
    },
    "budget": {
      "type": "object", "additionalProperties": false,
      "required": ["declared", "caps"],
      "properties": {
        "declared": {
          "type": "object", "additionalProperties": false,
          "required": ["scenario_runs", "maximum_attempts", "maximum_native_sessions"],
          "properties": {
            "scenario_runs": {"type": "integer", "minimum": 1},
            "maximum_attempts": {"type": "integer", "minimum": 1},
            "maximum_native_sessions": {"type": "integer", "minimum": 1}
          }
        },
        "caps": {
          "type": "object", "additionalProperties": false,
          "required": ["submitted_turns", "tokens_total_when_observable", "artifact_files", "artifact_file_bytes", "artifact_total_bytes", "spend", "quota", "operator_minutes", "wall_clock_minutes"],
          "properties": {
            "submitted_turns": {"type": "integer", "minimum": 1},
            "tokens_total_when_observable": {"type": "integer", "minimum": 1},
            "artifact_files": {"type": "integer", "minimum": 1},
            "artifact_file_bytes": {"type": "integer", "minimum": 1},
            "artifact_total_bytes": {"type": "integer", "minimum": 1},
            "operator_minutes": {"type": "integer", "minimum": 1},
            "wall_clock_minutes": {"type": "integer", "minimum": 1},
            "spend": {
              "type": "object", "additionalProperties": false,
              "required": ["currency", "maximum", "measurement_source", "zero_cost_reason"],
              "properties": {
                "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
                "maximum": {"type": "number", "minimum": 0},
                "measurement_source": {"$ref": "#/$defs/text"},
                "zero_cost_reason": {"$ref": "#/$defs/nullable_text"}
              }
            },
            "quota": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/quota"}}
          }
        }
      }
    },
    "quota": {
      "type": "object", "additionalProperties": false,
      "required": ["quota_id", "target_id", "source", "unit", "baseline", "maximum_delta", "absolute_stop", "observed_at", "evidence_sha256", "freshness_seconds", "check", "unreadable_before_first_launch", "unreadable_after_launch"],
      "properties": {
        "quota_id": {"$ref": "#/$defs/id"},
        "target_id": {"$ref": "#/$defs/id"},
        "source": {"$ref": "#/$defs/nullable_text"},
        "unit": {"enum": ["percentage_points", "requests", "tokens", "unknown"]},
        "baseline": {"$ref": "#/$defs/nullable_number"},
        "maximum_delta": {"$ref": "#/$defs/nullable_number"},
        "absolute_stop": {"$ref": "#/$defs/nullable_number"},
        "observed_at": {"$ref": "#/$defs/nullable_text"},
        "evidence_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "freshness_seconds": {"type": "integer", "minimum": 1},
        "check": {"const": "before_every_submission_and_retry"},
        "unreadable_before_first_launch": {"const": "stop_without_live_attempt"},
        "unreadable_after_launch": {"const": "finish_current_attempt_only_no_retry_report_unknown"}
      }
    },
    "retry_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["maximum_retries_per_scenario", "allowed_reasons", "retain_all_attempts", "uncertain_submitted_attempt", "retries_count_toward_all_caps"],
      "properties": {
        "maximum_retries_per_scenario": {"type": "integer", "minimum": 0},
        "allowed_reasons": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}},
        "retain_all_attempts": {"const": true},
        "uncertain_submitted_attempt": {"const": "do_not_duplicate"},
        "retries_count_toward_all_caps": {"const": true}
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["methodology_commit", "created_at", "owner", "source_records"],
      "properties": {
        "methodology_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "created_at": {"$ref": "#/$defs/text"},
        "owner": {"$ref": "#/$defs/text"},
        "source_records": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["source_id", "url", "inspected_at"],
            "properties": {
              "source_id": {"$ref": "#/$defs/id"},
              "url": {"type": "string", "format": "uri", "pattern": "^https://.+"},
              "inspected_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
            }
          }
        }
      }
    }
  }
}
